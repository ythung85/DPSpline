# Load necessary libraries
library(MASS)     # For multivariate computations
library(kernlab)  # For Gaussian Process regression
library(pracma)   # For numerical integration
library(ggplot2)
library(splines) # Spline expansion
# Function
# Define kernel function (Gaussian RBF)
gaussian_kernel <- function(x, y, sigma = 2) {
exp(- (x - y)^2 / (2 * sigma^2))
}
# Compute integral operator R(x)
compute_R <- function(x, D, kernel) {
f <- function(s) kernel(x, s)
integrate(f, min(D), max(D))$value / (max(D) - min(D))  # Normalize by domain length
}
# Compute average R over D
compute_R_avg <- function(D, kernel) {
f <- function(x) compute_R(x, D, kernel)
integrate(Vectorize(f), min(D), max(D))$value / (max(D) - min(D))  # Ensure scalar output
}
# Compute k0 (centered kernel)
compute_k0 <- function(x, y, D, kernel, R_avg) {
R_x <- compute_R(x, D, kernel)
R_y <- compute_R(y, D, kernel)
kernel(x, y) - (R_x * R_y) / R_avg
}
# Compute k1 (rank-1 component)
compute_k1 <- function(x, y, D, kernel, R_avg) {
R_x <- compute_R(x, D, kernel)
R_y <- compute_R(y, D, kernel)
(R_x * R_y) / R_avg
}
# Data set
set.seed(42)
n_train <- 50; d <- 5; UB <- 1; LB <- 0
n_train <- 50; d <- 50; UB <- 1; LB <- 0
X_train <- matrix(runif(n_train * d, min = LB, max =UB), ncol = d)  # n samples, d-dimensional
func1 <- sin(X_train[,1] + X_train[,2])
func2 <- X_train[,3]**2-1/3
func3 <- exp(-X_train[,4])+exp(-1)-1
func1 <- (func1 - mean(func1))/sd(func1)
func2 <- (func2 - mean(func2))/sd(func2)
func3 <- (func3 - mean(func3))/sd(func3)
y_train <- func1 + func2 + func3 + rnorm(n_train, sd = 0.1)  # Add noise
func1 <- sin(X_train[,1] + X_train[,2])
func1 <- func1 - mean(func1)
func2 <- X_train[,3]**2-1/3
func2 <- func2 - mean(func2)
func3 <- exp(-X_train[,4])+exp(-1)-1
func3 <- func3 - mean(func3)
y_train <- func1 + func2 + func3 + rnorm(n_train, sd = 0.1)  # Add noise
D <- seq(LB, UB, length.out = 500) # Define domain
# Combine into a single design matrix
R_avg <- compute_R_avg(D, gaussian_kernel)
#k_full_2 <- outer(X_train[,2], X_train[,2], Vectorize(function(x, y) gaussian_kernel(x, y)))
