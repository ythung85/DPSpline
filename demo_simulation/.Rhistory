df <- data.frame(x = X_train[,1], ty = func1, yp1 = y_predx1, yp2 = y_predx1_b,
yp3 = y_predx1x2, yp4 = y_predx1x2_b)
ggplot(data = df, aes(X_train[,1], ty)) +
geom_point(aes(x = X_train[,1], y = ty), colour='red') +
geom_point(aes(x = X_train[,1], y = yp3), colour='green') +
geom_point(aes(x = X_train[,1], y = yp4), colour='orange')
n_train <- 50; d <- 5; UB <- 1; LB <- 0
X_train <- matrix(runif(n_train * d, min = LB, max =UB), ncol = d)  # n samples, d-dimensional
func1 <- sin(X_train[,1] + X_train[,2])
func1 <- func1 - mean(func1)
func2 <- X_train[,3]**2-1/3
func2 <- func2 - mean(func2)
func3 <- exp(-X_train[,4])+exp(-1)-1
func3 <- func3 - mean(func3)
y_train <- func1 + func2 + func3 + rnorm(n_train, sd = 0.1)  # Add noise
D <- seq(LB, UB, length.out = 500) # Define domain
# Combine into a single design matrix
R_avg <- compute_R_avg(D, gaussian_kernel)
#k_full_2 <- outer(X_train[,2], X_train[,2], Vectorize(function(x, y) gaussian_kernel(x, y)))
#k1_matrix_1 <- outer(X_train[,1], X_train[,1], Vectorize(function(x, y) compute_k1(x, y, D, gaussian_kernel, R_avg)))
#k1_matrix_2 <- outer(X_train[,2], X_train[,2], Vectorize(function(x, y) compute_k1(x, y, D, gaussian_kernel, R_avg)))
k0_matrix_1 <- outer(X_train[,1], X_train[,1], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
k0_matrix_2 <- outer(X_train[,2], X_train[,2], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
k0_matrix_3 <- outer(X_train[,3], X_train[,3], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
k0_matrix_4 <- outer(X_train[,4], X_train[,4], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
k0_matrix_5 <- outer(X_train[,5], X_train[,5], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
K0_matrix_all <- 1
for (i in 1:d) {
k0_matrix <- outer(X_train[,i], X_train[,i], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
#k0_matrix <- outer(X_train[,i], X_train[,i], Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
K0_matrix_all <- K0_matrix_all * (1 + k0_matrix)
}
ones = matrix(rep(1, n_train),nrow = 1)
bias = (ones %*% solve(K0_matrix_all)) %*% y_train
y_predx1 <- (t(k0_matrix_1) %*% solve(K0_matrix_all)) %*% y_train
y_predx1_b <- (t(1+k0_matrix_1) %*% solve(K0_matrix_all)) %*% y_train
y_predx2 <- (t(k0_matrix_2) %*% solve(K0_matrix_all)) %*% y_train
y_predx2_b <- (t(1+k0_matrix_2) %*% solve(K0_matrix_all)) %*% y_train
y_predx3 <- (t(k0_matrix_3) %*% solve(K0_matrix_all)) %*% y_train
y_predx3_b <- (t(1+k0_matrix_3) %*% solve(K0_matrix_all)) %*% y_train
y_predx4 <- (t(k0_matrix_4) %*% solve(K0_matrix_all)) %*% y_train
y_predx4_b <- (t(1+k0_matrix_4) %*% solve(K0_matrix_all)) %*% y_train
y_predx5 <- (t(k0_matrix_5) %*% solve(K0_matrix_all)) %*% y_train
y_predx5_b <- (t(1+k0_matrix_5) %*% solve(K0_matrix_all)) %*% y_train
y_predx1x2 <- (t(k0_matrix_1 * k0_matrix_2) %*% solve(K0_matrix_all)) %*% y_train
y_predx1x2_b <- (t((1+k0_matrix_1) * (1+k0_matrix_2)) %*% solve(K0_matrix_all)) %*% y_train
y_predx1x3_b <- (t((1+k0_matrix_1) * (1+k0_matrix_3)) %*% solve(K0_matrix_all)) %*% y_train
y_predx1x4_b <- (t((1+k0_matrix_1) * (1+k0_matrix_4)) %*% solve(K0_matrix_all)) %*% y_train
y_predx1x5_b <- (t((1+k0_matrix_1) * (1+k0_matrix_5)) %*% solve(K0_matrix_all)) %*% y_train
df <- data.frame(x = X_train[,1], ty = func1, yp1 = y_predx1, yp2 = y_predx1_b,
yp3 = y_predx1x2, yp4 = y_predx1x2_b)
ggplot(data = df, aes(X_train[,1], ty)) +
geom_point(aes(x = X_train[,1], y = ty), colour='red') +
geom_point(aes(x = X_train[,1], y = yp3), colour='green') +
geom_point(aes(x = X_train[,1], y = yp4), colour='orange')
ggplot(data = df, aes(ty, yp3)) +
geom_point(aes(x = ty, y = yp3), colour='red')+
geom_point(aes(x = ty, y = yp4), colour='purple')
asset.paths <- function(s0, mu, sigma,
nsims = 10000,
periods = c(0, 1)   # time periods at which to simulate prices
)
{
s0 = as.vector(s0)
nsteps = len(periods)
dt = c(periods[1], diff(periods))
if( len(s0) == 1 ) {
drift = mu - 0.5 * sigma^2
if( nsteps == 1 ) {
s0 * exp(drift * dt + sigma * sqrt(dt) * rnorm(nsims))
} else {
temp = matrix(exp(drift * dt + sigma * sqrt(dt) * rnorm(nsteps * nsims)), nc=nsims)
for(i in 2:nsteps) temp[i,] = temp[i,] * temp[(i-1),]
s0 * temp
}
} else {
require(MASS)
drift = mu - 0.5 * diag(sigma)
n = len(mu)
if( nsteps == 1 ) {
s0 * exp(drift * dt + sqrt(dt) * t(mvrnorm(nsims, rep(0, n), sigma)))
} else {
temp = array(exp(as.vector(drift %*% t(dt)) + t(sqrt(dt) * mvrnorm(nsteps * nsims, rep(0, n), sigma))), c(n, nsteps, nsims))
for(i in 2:nsteps) temp[,i,] = temp[,i,] * temp[,(i-1),]
s0 * temp
}
}
}
S = c(100,105)
X = 98
Time = 0.5
r = 0.05
sigma = c(0.11,0.16)
rho = 0.63
N = 10000
# Single Asset for 10 years
periods = 0:10
prices = asset.paths(S[1], r, sigma[1], N, periods = periods)
