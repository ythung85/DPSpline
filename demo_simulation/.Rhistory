k0_matrix_1 <- outer(X_train[,1], y_train, Vectorize(function(x, y) compute_k0(x, y, D, gaussian_kernel, R_avg)))
View(k0_matrix_1)
K0_matrix_all <- 1
for (i in 1:d) {
