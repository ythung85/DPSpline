#' @param n Sample size
#' @param p Number of predictors
#' @param sigma Noise level
#' @param model_type Type of model
#' @param degree B-spline degree
#' @param n_knots Number of knots
#' @param seed Random seed
#' @param verbose Print progress
#' @return List containing lambda matrix and summary statistics
set.seed(seed)
length.list <- vector("list", length = n_sims)
# Track computation time
start_time <- Sys.time()
# Run simulations
for (sim in 1:n_sims) {
if (verbose && sim %% 10 == 0) {
cat("Running simulation", sim, "of", n_sims, "...\n")
}
# Generate data
data <- generate_data(n, p, sigma, model_type)
# Compute lambda values
lambda_values <- mc_sis_bspline(data$Y, data$X, degree, n_knots)
order_indice <- order(lambda_values, decreasing = TRUE)
# Store results
length.list[[sim]] = max(which(order_indice %in% data$TS))
}
end_time <- Sys.time()
computation_time <- difftime(end_time, start_time, units = "secs")
return (list(length = length.list, comp_time = computation_time))
}
